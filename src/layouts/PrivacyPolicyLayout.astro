---
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    projectName: string;
    projectHref: string;
    lang?: string;
    description?: string;
    translations?: { label: string; href: string; lang: string }[];
  };
}

const { title, projectName, projectHref, lang = "en", description, translations = [] } = Astro.props.frontmatter;
---

<Layout title={`${title} - Tomás Hurrell`} lang={lang} description={description}>
  <main class="my-32 px-4 md:px-16 lg:px-32 xl:px-64">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <a href={projectHref} class="text-sm underline underline-offset-4">
        {lang === "es" ? "Volver a" : "Back to"} {projectName}
      </a>
      {translations.length > 0 && (
        <nav aria-label={lang === "es" ? "Idioma de la política" : "Policy language"} class="flex gap-4 text-sm">
          {translations.map((translation) => (
            <a href={translation.href} lang={translation.lang} hreflang={translation.lang}
              aria-current={translation.lang === lang ? "page" : undefined}
              class="underline underline-offset-4 aria-[current=page]:font-semibold">
              {translation.label}
            </a>
          ))}
        </nav>
      )}
    </div>
    <article class="mt-10 prose lg:prose-md dark:prose-invert">
      <slot />
    </article>
  </main>
</Layout>
